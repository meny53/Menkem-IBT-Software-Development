from abc import ABC, abstractmethod
class Vehicle(ABC):
    def __init__(self, make, model):
        self.make = make
        self.model = model
    def describe(self):
        print(f"Vehicle: {self.make} {self.model}")
    @abstractmethod
    def wheels(self):
        pass
class Car(Vehicle):
    def wheels(self):
        return 4
class Truck(Vehicle):
    def wheels(self):
        return 6
car1 = Car("Toyota", "Corolla")
truck1 = Truck("Volvo", "FH16")
print(car1.wheels())
print(truck1.wheels())