class Vehicle:
    def __init__(self, make, model):
        self.make = make
        self.model = model
class Truck(Vehicle):
    def __init__(self, make, model, capacity):
        super().__init__(make, model)
        self.capacity = capacity
truck1 = Truck("Volvo", "FH16", 20)
print(truck1.make)
print(truck1.model)
print(truck1.capacity)